{
  "name": "tributate-ya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:vercel": "node scripts/tokenVercel.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ver": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:limpiar": "node --env-file=.env.local scripts/limpiar-cliente.mjs",
    "probar:flujo": "node --env-file=.env.local node_modules/vite-node/vite-node.mjs --config scripts/vite.config.ts scripts/probar-flujo.ts",
    "probar:api": "node --env-file=.env.local scripts/probar-api.mjs",
    "db:migrar": "node --env-file=.env.local scripts/migrar.mjs",
    "db:verificar": "node --env-file=.env.local scripts/verificar-bd.mjs"
  },
  "dependencies": {
    "@vercel/connect": "latest",
    "framer-motion": "^12.23.12",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "latest",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vercel": "latest",
    "vitest": "^3.2.4"
  }
}
